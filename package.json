{
  "name": "@copilot/a2ui-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:clean": "rm -rf dist",
    "build": "npm run build:clean && npm run build:lib && npm run build:iife",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:iife": "vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "typescript": "~6.0.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
